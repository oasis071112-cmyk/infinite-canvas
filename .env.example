# Production public origin. HTTPS is mandatory for the anonymous HttpOnly cookie.
APP_ORIGIN=https://canvas.example.com
COOKIE_SECURE=true

# Generate once and back it up securely: openssl rand -base64 32
# PowerShell alternative: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
API_KEY_MASTER_KEY=

PORT=4000
SESSION_DAYS=365
CALL_LOG_DAYS=90
MAX_JSON_BYTES=20971520
MAX_UPLOAD_BYTES=52428800
MAX_RESPONSE_BYTES=104857600
UPSTREAM_TIMEOUT_MS=600000
SESSION_AI_CONCURRENCY=4
IP_AI_CONCURRENCY=8
GLOBAL_AI_CONCURRENCY=20
LOG_LEVEL=info

ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=
